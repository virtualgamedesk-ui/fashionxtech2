# Copy this file to .env, fill in ONE option, then restart (npm start).

# --- FREE: Hugging Face token ---
# huggingface.co → Settings → Access Tokens → Create new token (type "Read" is enough).
# Uses free try-on Spaces with your account's daily free GPU time. Run "npm install" once first.
HF_TOKEN=
# Spaces tried in order (comma separated):
# HF_SPACE=Kwai-Kolors/Kolors-Virtual-Try-On,yisol/IDM-VTON

# --- Google AI Studio key (Gemini image model) ---
# Make one at aistudio.google.com → Get API key. Image output needs billing turned on for that key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-nano-banana-2.1

# --- ChatGPT / OpenAI API key ---
# Make one at platform.openai.com → API keys. Needs API credit (separate from a ChatGPT Plus subscription).
# OPENAI_API_KEY=

# --- Image API in OpenAI format (what your friend's code uses) ---
# Lovable AI Gateway: use the LOVABLE_API_KEY from the Lovable project.
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://ai.gateway.lovable.dev
# IMAGE_MODEL=openai/gpt-image-2.5-sunburst

# --- Free: Cloudflare Workers AI (about 80-120 images a day) ---
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# --- Paid: FASHN try-on API ---
# FASHN_API_KEY=

# PORT=8000
